{
    "name": "lessconfig-js",
    "version": "0.0.1",
    "description": "LessConfig SDK for JavaScript and TypeScript",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/lessconfig/lessconfig-js.git"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
        "check:package": "npm run build && node scripts/check-package.mjs",
        "prepack": "npm run check",
        "lint": "oxlint",
        "format": "oxfmt .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "lodash-es": "^4.18.1"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.0.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "typescript": "~6.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=18"
    }
}
